# Copy to .env and adjust. Used by docker-compose.yml and by `cargo run`.

# --- Server ---------------------------------------------------------------
# Protects project creation (POST /api/v1/projects). Use a long random value.
ADMIN_TOKEN=change-me
# Base URL of the dashboard, used in links printed by the reporter.
PUBLIC_URL=http://localhost:8080
BIND_ADDR=0.0.0.0:8080
RUST_LOG=info

# --- PostgreSQL -----------------------------------------------------------
POSTGRES_USER=klovplay
POSTGRES_PASSWORD=klovplay
POSTGRES_DB=klovplay
DATABASE_URL=postgres://klovplay:klovplay@localhost:5432/klovplay

# --- S3-compatible artifact storage ----------------------------------------
S3_BUCKET=klovplay-artifacts
S3_REGION=us-east-1
S3_ENDPOINT=http://localhost:9000
S3_PUBLIC_ENDPOINT=http://localhost:9000
S3_FORCE_PATH_STYLE=true
S3_ACCESS_KEY_ID=klovplay
S3_SECRET_ACCESS_KEY=klovplay-secret
S3_ENSURE_BUCKET=true

# --- Ingestion tuning -----------------------------------------------------
# INGEST_CHANNEL_CAPACITY=50000
# FLUSH_MAX_EVENTS=250
# FLUSH_INTERVAL_MS=200
# STALE_LAUNCH_MINUTES=30
