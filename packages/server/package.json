{
  "name": "@klov/server",
  "version": "0.1.0",
  "description": "Klov report server: real-time ingestion, analytics API and dashboard host for Playwright runs",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "klov-server": "./dist/index.js"
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-migrations.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "migrate": "node dist/db/migrate-cli.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/lib-storage": "^3.700.0",
    "@fastify/compress": "^8.1.0",
    "@fastify/static": "^8.2.0",
    "@klov/shared": "0.1.0",
    "fastify": "^5.4.0",
    "pg": "^8.16.0",
    "playwright-core": "^1.56.1",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/pg": "^8.15.0",
    "tsx": "^4.20.0",
    "vitest": "^3.2.0"
  }
}
