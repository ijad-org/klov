{
  "name": "klovplay",
  "private": true,
  "description": "KlovPlay: real-time Playwright reporting server and Allure-grade analytics",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "codegen": "cargo test -p klovplay-schema",
    "build": "pnpm -r --filter ./packages/** --filter ./apps/** run build",
    "typecheck": "pnpm -r run typecheck",
    "test": "pnpm -r run test",
    "dev:web": "pnpm --filter @klovplay/web dev",
    "demo": "pnpm --filter klovplay-example test"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
